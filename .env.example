# Groq APIキー(console.groq.comで取得・無料)
GROQ_API_KEY=

GROQ_MODEL=llama-3.3-70b-versatile

# Groq無料枠のTPM(1分あたりトークン数)上限の目安。
# console.groq.com/settings/limits で自分のプラン・モデルの実際の値を確認して調整してください。
# 実測でまだ429が出るようなら、この値を下げてください。
GROQ_TPM_LIMIT=10000

# SharePointサイトURL(末尾スラッシュなし)
SP_SITE_URL=https://contoso.sharepoint.com/sites/TeamA

# 探索したいドキュメントライブラリのサーバー相対URL
# 例: /sites/TeamA/共有ドキュメント や /sites/TeamA/Shared Documents
SP_LIBRARY_PATH=/sites/TeamA/Shared Documents

# Playwrightで保存するログインセッションの置き場所(通常は変更不要)
SESSION_STATE_PATH=./storage_state.json

# 探索したファイルツリーのローカルキャッシュ置き場所(通常は変更不要、.gitignore対象)
TREE_CACHE_PATH=./tree_cache.json

# 検索フォームの選択肢(分野/担当科の仕分け結果)のキャッシュ置き場所(通常は変更不要、.gitignore対象)
FACET_CACHE_PATH=./facet_cache.json
