# 合言葉（アプリのログインパスワード）
APP_PASSWORD=change-me

# セッション署名用のランダム文字列（何でもいいので長い乱数文字列にする）
SESSION_SECRET=change-me-too

# Groq APIキー（console.groq.com で取得）
GROQ_API_KEY=

# Groqで使うモデル
GROQ_MODEL=llama-3.3-70b-versatile

# Microsoft Graph 用クライアントID
# 自分でアプリ登録できない場合は、Microsoft公式の
# 「Microsoft Graph PowerShell」の既知クライアントIDを流用可能（多くのテナントで既定有効）
GRAPH_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dab67e

# 対象テナント（会社/大学の固有テナントIDまたはドメイン。共通なら common のままでOK）
GRAPH_AUTHORITY=https://login.microsoftonline.com/common

# 要求する権限スコープ（委任アクセス・自分の権限の範囲内）
GRAPH_SCOPES=Sites.Read.All Files.Read.All
